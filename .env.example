# ==============================================================================
# Automated Open-Source PR Chronicler and Learning Dispatcher - Configuration
# ==============================================================================

# Application Environment & Server Settings
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

# Logging Settings
LOG_LEVEL=INFO
LOG_FILE=pr_chronicler.log

# ------------------------------------------------------------------------------
# Future Phases Configuration (Stubs - to be configured in later phases)
# ------------------------------------------------------------------------------

# GitHub Integration & Context Hydration (Phases 2 & 3)
# Optional: Personal Access Token with repo read scope (increases GitHub API rate limits)
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
GITHUB_TEST_REPOSITORY=encode/httpx
GITHUB_TEST_PR_NUMBER=103

# Google Generative AI / Gemini (Phase 4+)
# API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Email / SMTP Dispatcher (Phase 5)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your_email@gmail.com
SMTP_APP_PASSWORD=your_16_character_google_app_password
SMTP_USE_TLS=true
# Set to 'true' to safely test/verify email assembly without transmitting over network:
SMTP_DRY_RUN=true
DISPATCH_RECIPIENTS=your_email@gmail.com
